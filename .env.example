# LLM (OpenAI-compatible)
# Mode A (single provider): openai | groq
#LLM_PROVIDER=
# Mode B (fallback): try primary first, then secondary
LLM_PRIMARY_PROVIDER=openai
LLM_SECONDARY_PROVIDER=groq

# Optional global model alias.
# If empty, system will use provider defaults:
# - OPENAI_MODEL for OpenAI
# - GROQ_MODEL for Groq
LLM_MODEL=
LLM_REQUEST_TIMEOUT=30

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound

# AI feature modes: none | hybrid | ai
